<script>
const shopId = "<%= restaurant._id %>";
const isLoggedIn = <%= currentUser ? true : false %>;
socket.emit("joinShop", shopId);

const avgRatingEl = document.getElementById("avgRating");
const reviewContainer = document.querySelector(".review-card")?.parentElement;

socket.on("ratingUpdated", (data) => {
  animateNumber(avgRatingEl, parseFloat(avgRatingEl.innerText), parseFloat(data.averageRating), 500);
});

/* ⭐ Animated Number */
function animateNumber(element, start, end, duration) {
  let startTime = null;

  function animation(currentTime) {
    if (!startTime) startTime = currentTime;
    const progress = Math.min((currentTime - startTime) / duration, 1);
    element.innerText = (start + (end - start) * progress).toFixed(1);
    if (progress < 1) requestAnimationFrame(animation);
  }

  requestAnimationFrame(animation);
}

/* ⭐ STAR RATING ANIMATION */
let selectedRating = 0;
const stars = document.querySelectorAll(".star");

stars.forEach((star, index) => {

  star.addEventListener("mouseover", () => {
    stars.forEach((s, i) => {
      s.classList.toggle("active", i <= index);
      s.style.transform = i <= index ? "scale(1.2)" : "scale(1)";
    });
  });

  star.addEventListener("mouseout", () => {
    stars.forEach((s, i) => {
      s.classList.toggle("active", i < selectedRating);
      s.style.transform = "scale(1)";
    });
  });

  star.addEventListener("click", () => {
    selectedRating = star.dataset.value;
    stars.forEach((s, i) => {
      s.classList.toggle("active", i < selectedRating);
    });
  ratingError.classList.add("d-none");
  starContainer.classList.remove("border", "border-danger", "rounded", "p-2");
  });

});
document.getElementById("submitRating").addEventListener("click", async (e) => {



 e.preventDefault();


  // if (!selectedRating) {
  //   alert("Please select rating");
  //   return;
  // }


const ratingError = document.getElementById("ratingError");
const starContainer = document.getElementById("starContainer");

if (!selectedRating) {
  ratingError.classList.remove("d-none");

  starContainer.classList.add("border", "border-danger", "rounded", "p-2");

  starContainer.classList.add("error-shake");
  setTimeout(() => {
    starContainer.classList.remove("error-shake");
  }, 300);

  starContainer.scrollIntoView({ behavior: "smooth", block: "center" });

  return;
}
  const comment = document.getElementById("feedbackComment").value.trim();

  const res = await fetch(`/mobileShop/${shopId}/rate`, {
    method: "POST",
    headers: { "Content-Type": "application/json",
       "x-page-url": window.location.pathname
     },


    body: JSON.stringify({
      value: Number(selectedRating),
      comment: comment
    })
  });
  if (res.status === 401) {
  // alert("Please login first");
  window.location.href = "/users/login";
  return;
}
  const data = await res.json();

  if (data.success) {
showFlashMessage("Review submitted successfully ⭐", "success");
    /* ⭐ Create new review card dynamically */
    const newCard = document.createElement("div");
    newCard.className = "review-card";
    newCard.style.opacity = "0";
    newCard.style.transform = "translateY(20px)";

    let starsHTML = "";
    for (let i = 1; i <= 5; i++) {
      starsHTML += i <= selectedRating ? "★" : "☆";
    }

    newCard.innerHTML = `
      <div class="d-flex justify-content-between align-items-center">
        <strong>You</strong>
        <div class="review-stars">${starsHTML}</div>
      </div>
      <p class="small text-muted mt-2 mb-0">
        "${comment}"
      </p>
    `;

    document.querySelector(".col-lg-5").appendChild(newCard);

    /* Animate in */
    setTimeout(() => {
      newCard.style.transition = "all 0.4s ease";
      newCard.style.opacity = "1";
      newCard.style.transform = "translateY(0)";
    }, 50);

    /* Reset form */
    document.getElementById("feedbackComment").value = "";
    selectedRating = 0;
    stars.forEach(s => s.classList.remove("active"));
  }

});
</script>

<script> // flash message for rating
function showFlashMessage(message, type = "success") {
  const flash = document.createElement("div");

  flash.className = `
    position-fixed top-0 start-50 translate-middle-x mt-3 px-4 py-2
    rounded shadow fw-semibold
  `;

  flash.style.zIndex = "9999";

  if (type === "success") {
    flash.style.background = "#e0f2fe";
    flash.style.color = "#0369a1";
  } else {
    flash.style.background = "#fee2e2";
    flash.style.color = "#991b1b";
  }

  flash.innerText = message;

  document.body.appendChild(flash);

  setTimeout(() => {
    flash.style.transition = "opacity 0.5s";
    flash.style.opacity = "0";
    setTimeout(() => flash.remove(), 500);
  }, 3000);
}
</script>
