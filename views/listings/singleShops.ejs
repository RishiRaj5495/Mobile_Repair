

<% layout("/layouts/boilerPlate") %>

<style>
body {
  background: #f4f7fb;
}

/* LEFT CARD */
.shop-card {
  background: white;
  border-radius: 20px;
  padding: 25px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}

.badge-soft {
  background: #eef2ff;
  color: #2563eb;
  font-size: 13px;
  padding: 6px 12px;
  border-radius: 20px;
  margin-left: 8px;
}

.rating-box {
  background: #fff4db;
  padding: 10px 15px;
  border-radius: 10px;
  font-weight: 600;
  display: inline-block;
}

.location-box {
  background: #f1f5f9;
  padding: 12px;
  border-radius: 12px;
  margin-top: 15px;
}

/* REVIEW SECTION */
.review-card {
  background: white;
  border-radius: 15px;
  padding: 18px;
  margin-bottom: 15px;
  box-shadow: 0 6px 20px rgba(0,0,0,0.04);
}

.review-stars {
  color: #f59e0b;
}

/* STAR INPUT */
.star {
  font-size: 28px;
  cursor: pointer;
  color: #d1d5db;
  transition: 0.2s;
}

.star.active {
  color: #f59e0b;
}

/* RIGHT FORM */
.form-card {
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 12px 35px rgba(0,0,0,0.08);
}

.form-header {
  background: linear-gradient(135deg,#2563eb,#1d4ed8);
  color: white;
  padding: 25px;
}

.form-body {
  background: white;
  padding: 30px;
}

.form-control {
  border-radius: 12px;
  background: #f1f5f9;
  border: none;
  padding: 12px;
}

.form-control:focus {
  box-shadow: none;
  background: #e2e8f0;
}

.submit-btn {
  background: linear-gradient(135deg,#2563eb,#1d4ed8);
  border: none;
  border-radius: 12px;
  padding: 14px;
  color: white;
  font-weight: 600;
  transition: 0.3s;
}

.submit-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(37,99,235,0.3);
}
.rating-box{
  font-weight: 600;
  font-size: 16px;
}


.error-shake {
  animation: shake 0.3s;
}
@keyframes shake {
  0% { transform: translateX(0); }
  25% { transform: translateX(-5px); }
  50% { transform: translateX(5px); }
  75% { transform: translateX(-5px); }
  100% { transform: translateX(0); }
}
/*
///////////////////////////// */
/* =========================================================
   VIDEO EVIDENCE SECTION
========================================================= */

.video-evidence-section {
    width: 100%;
}
/* =========================================================
   SECTION HEADER
========================================================= */

.video-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
}

.video-section-header h5 {
    font-weight: 650;
    color: #212529;
}

.video-required-badge {
    font-size: 11px;
    font-weight: 600;

    padding: 5px 9px;

    border-radius: 20px;

    background: #fff3cd;
    color: #856404;

    white-space: nowrap;
}


/* =========================================================
   UPLOAD BOX
========================================================= */

.video-upload-box {
    position: relative;

    border: 2px dashed #d7dce2;

    border-radius: 18px;

    padding: 42px 25px 30px;

    text-align: center;

    background:
        linear-gradient(
            180deg,
            #ffffff 0%,
            #f8fafc 100%
        );

    cursor: pointer;

    transition:
        border-color 0.25s ease,
        background 0.25s ease,
        transform 0.25s ease,
        box-shadow 0.25s ease;
}

.video-upload-box:hover {
    border-color: #4c8bf5;

    background:
        linear-gradient(
            180deg,
            #ffffff 0%,
            #f3f7ff 100%
        );

    box-shadow:
        0 8px 25px rgba(
            13,
            110,
            253,
            0.08
        );

    transform: translateY(-1px);
}

.video-upload-box.dragover {
    border-color: #0d6efd;

    background: #edf5ff;

    box-shadow:
        0 10px 30px rgba(
            13,
            110,
            253,
            0.14
        );

    transform: scale(1.01);
}


/* =========================================================
   UPLOAD ICON
========================================================= */

.upload-icon-wrapper {
    display: flex;
    justify-content: center;

    margin-bottom: 14px;
}

.upload-icon {
    width: 64px;
    height: 64px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 18px;

    background: #eaf2ff;

    font-size: 30px;

    box-shadow:
        0 5px 15px rgba(
            13,
            110,
            253,
            0.08
        );
}


/* =========================================================
   UPLOAD TEXT
========================================================= */

.upload-title {
    margin-bottom: 8px;

    font-size: 18px;

    font-weight: 650;

    color: #212529;
}

.upload-text {
    margin-bottom: 20px;

    color: #6c757d;

    font-size: 14px;

    line-height: 1.6;
}

.upload-text span {
    color: #0d6efd;

    font-weight: 500;
}


/* =========================================================
   UPLOAD BUTTON
========================================================= */

.upload-button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 8px;

    border: none;

    background: #0d6efd;

    color: #ffffff;

    padding: 11px 22px;

    border-radius: 9px;

    font-size: 14px;

    font-weight: 600;

    cursor: pointer;

    transition:
        background 0.2s ease,
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

.upload-button:hover {
    background: #0b5ed7;

    box-shadow:
        0 6px 15px rgba(
            13,
            110,
            253,
            0.22
        );

    transform: translateY(-1px);
}

.upload-button-icon {
    font-size: 18px;
}


/* =========================================================
   FORMAT TEXT
========================================================= */

.upload-format {
    margin-top: 17px;

    color: #8a929a;

    font-size: 11px;
}

.format-divider {
    margin: 0 7px;

    color: #c4c9ce;
}


/* =========================================================
   SELECTED VIDEO
========================================================= */

.selected-video {
    display: flex;

    align-items: center;

    gap: 13px;

    margin-top: 14px;

    padding: 14px 15px;

    border: 1px solid #dfe4ea;

    border-radius: 13px;

    background: #ffffff;

    box-shadow:
        0 3px 12px rgba(
            0,
            0,
            0,
            0.04
        );

    animation: selectedVideoIn 0.25s ease;
}

@keyframes selectedVideoIn {

    from {
        opacity: 0;
        transform: translateY(5px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

}


.video-file-icon {
    width: 45px;
    height: 45px;

    display: flex;

    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border-radius: 10px;

    background: #edf4ff;

    font-size: 22px;
}

.video-file-info {
    flex: 1;

    min-width: 0;
}

.video-file-name {
    color: #212529;

    font-size: 14px;

    font-weight: 600;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;
}

.video-file-size {
    margin-top: 3px;

    color: #8a929a;

    font-size: 12px;
}

.video-selected-status {
    width: 26px;
    height: 26px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #d1e7dd;

    color: #198754;

    font-size: 13px;

    font-weight: 700;
}

.remove-video {
    width: 32px;
    height: 32px;

    display: flex;

    align-items: center;
    justify-content: center;

    border: none;

    border-radius: 50%;

    background: transparent;

    color: #dc3545;

    font-size: 22px;

    line-height: 1;

    cursor: pointer;

    transition:
        background 0.2s ease,
        transform 0.2s ease;
}

.remove-video:hover {
    background: #fff0f1;

    transform: scale(1.05);
}


/* =========================================================
   ERROR
========================================================= */

.video-error {
    display: flex;

    align-items: center;

    gap: 7px;

    margin-top: 9px;

    padding: 9px 11px;

    border-radius: 8px;

    background: #fff5f5;

    color: #dc3545;

    font-size: 12px;
}

.error-icon {
    font-size: 14px;
}


/* =========================================================
   AI PROCESSING CARD
========================================================= */

.video-processing {
    margin-top: 16px;

    padding: 20px;

    border: 1px solid #dce6f5;

    border-radius: 16px;

    background:
        linear-gradient(
            145deg,
            #ffffff 0%,
            #f6f9ff 100%
        );

    box-shadow:
        0 8px 28px rgba(
            0,
            0,
            0,
            0.06
        );

    animation: processingIn 0.3s ease;
}

@keyframes processingIn {

    from {
        opacity: 0;
        transform: translateY(8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

}


/* =========================================================
   PROCESSING HEADER
========================================================= */

.processing-header {
    display: flex;

    align-items: center;

    gap: 13px;
}

.processing-icon-wrapper {
    position: relative;

    width: 48px;
    height: 48px;

    display: flex;

    align-items: center;
    justify-content: center;

    flex-shrink: 0;
}

.processing-icon {
    position: relative;

    z-index: 2;

    width: 44px;
    height: 44px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 13px;

    background: #eaf2ff;

    color: #0d6efd;

    font-size: 21px;
}

.processing-pulse {
    position: absolute;

    inset: 0;

    border-radius: 14px;

    border: 2px solid #9ec5fe;

    animation: processingPulse 1.5s infinite;
}

@keyframes processingPulse {

    0% {
        opacity: 0.8;
        transform: scale(0.85);
    }

    100% {
        opacity: 0;
        transform: scale(1.35);
    }

}

.processing-header-text {
    flex: 1;
}

.processing-title-row {
    display: flex;

    align-items: center;

    gap: 7px;
}

.processing-title-row h6 {
    margin: 0;

    font-size: 16px;

    font-weight: 650;

    color: #212529;
}

.ai-badge {
    padding: 2px 6px;

    border-radius: 5px;

    background: #e7f1ff;

    color: #0d6efd;

    font-size: 9px;

    font-weight: 700;

    letter-spacing: 0.4px;
}

.processing-header-text p {
    margin: 4px 0 0;

    color: #6c757d;

    font-size: 12px;
}


/* =========================================================
   PROGRESS
========================================================= */

.processing-progress-container {
    margin-top: 20px;
}

.processing-progress-top {
    display: flex;

    justify-content: space-between;

    margin-bottom: 7px;

    color: #6c757d;

    font-size: 11px;
}

.processing-progress-top span:last-child {
    color: #0d6efd;

    font-weight: 600;
}

.video-progress {
    height: 7px;

    overflow: hidden;

    border-radius: 20px;

    background: #e9ecef;
}

.video-progress .progress-bar {
    border-radius: 20px;

    background: #0d6efd;

    transition:
        width 0.6s ease;

    position: relative;

    overflow: hidden;
}

.video-progress .progress-bar::after {
    content: "";

    position: absolute;

    top: 0;
    left: 0;
    right: 0;
    bottom: 0;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(255,255,255,0.35),
            transparent
        );

    animation: progressShine 1.5s infinite;
}

@keyframes progressShine {

    from {
        transform: translateX(-100%);
    }

    to {
        transform: translateX(100%);
    }

}


/* =========================================================
   PROCESSING STEPS
========================================================= */

.processing-steps {
    margin-top: 20px;

    padding-left: 2px;
}

.processing-step {
    position: relative;

    display: flex;

    align-items: flex-start;

    gap: 11px;

    padding: 8px 0;

    color: #adb5bd;

    transition:
        color 0.25s ease;
}

.processing-step:not(:last-child)::after {
    content: "";

    position: absolute;

    left: 11px;

    top: 34px;

    width: 1px;

    height: 19px;

    background: #e5e7eb;
}

.step-icon {
    width: 24px;
    height: 24px;

    display: flex;

    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border-radius: 50%;

    background: #edf0f2;

    color: #899198;

    font-size: 10px;

    font-weight: 600;

    transition:
        background 0.25s ease,
        color 0.25s ease,
        transform 0.25s ease;
}

.step-content {
    padding-top: 2px;
}

.step-title {
    font-size: 12px;

    font-weight: 600;
}

.step-description {
    margin-top: 2px;

    font-size: 10px;

    color: #adb5bd;
}


/* ACTIVE */

.processing-step.active {
    color: #212529;
}


/* PROCESSING */

.processing-step.processing {
    color: #0d6efd;
}

.processing-step.processing .step-icon {
    background: #cfe2ff;

    color: #0d6efd;

    animation: stepPulse 1.2s infinite;
}

.processing-step.processing .step-description {
    color: #6c9fe8;
}

@keyframes stepPulse {

    0% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.1);
    }

    100% {
        transform: scale(1);
    }

}


/* COMPLETED */

.processing-step.completed {
    color: #198754;
}

.processing-step.completed .step-icon {
    background: #d1e7dd;

    color: #198754;
}

.processing-step.completed .step-description {
    color: #75a98e;
}


/* =========================================================
   PROCESSING NOTICE
========================================================= */

.processing-notice {
    display: flex;

    align-items: center;

    gap: 7px;

    margin-top: 16px;

    padding: 9px 11px;

    border-radius: 8px;

    background: #f1f5f9;

    color: #64748b;

    font-size: 10px;
}

.notice-icon {
    font-size: 12px;
}


/* =========================================================
   RESULT
========================================================= */

.video-result {
    margin-top: 15px;

    animation: resultIn 0.3s ease;
}

@keyframes resultIn {

    from {
        opacity: 0;
        transform: translateY(5px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

}

.video-result .alert {
    margin-bottom: 0;

    border-radius: 12px;

    padding: 13px 15px;

    font-size: 13px;
}


/* =========================================================
   HIDDEN
========================================================= */

.d-none {
    display: none !important;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 576px) {

    .video-upload-box {
        padding: 32px 18px 25px;
    }

    .video-section-header {
        align-items: flex-start;
    }

    .upload-icon {
        width: 56px;
        height: 56px;

        font-size: 26px;
    }

    .upload-title {
        font-size: 16px;
    }

    .selected-video {
        gap: 9px;
    }

    .video-selected-status {
        display: none;
    }

    .video-processing {
        padding: 16px;
    }

}
</style>

<div class="container my-5">
  <div class="row g-4">

    <!-- LEFT SIDE -->
    <div class="col-lg-5">

      <div class="shop-card mb-4">

  <!-- Shop name + rating -->
  <div class="d-flex justify-content-between align-items-center">
    <h3 class="fw-bold mb-0">
      <%= restaurant.name %>
    </h3>

    <div class="rating-box">
      <span id="avgRating"><%= restaurant.averageRating || 0 %></span> ⭐
    </div>
  </div>

  <!-- Categories below -->
  <div class="mt-2">
    <span class="badge-soft">Accessories</span>
    <span class="badge-soft">Parts</span>
  </div>

  <!-- Reviews -->
  <div class="mt-2 text-muted">
    <%= restaurant.totalRatings || 0 %> Reviews
  </div>

  <!-- Address -->
  <div class="location-box">
    <i class="fa-solid fa-location-dot text-primary"></i>
    <%= restaurant.address %>
  </div>

</div>


      <div class="shop-card mb-4">

        <h5 class="fw-bold mb-3">Leave a Review</h5>

        <p class="small text-muted">Tap to rate your experience</p>

        <div id="starContainer" class="mb-3">
          <span class="star" data-value="1">★</span>
          <span class="star" data-value="2">★</span>
          <span class="star" data-value="3">★</span>
          <span class="star" data-value="4">★</span>
          <span class="star" data-value="5">★</span>
        </div>
        <div id="ratingError" class="text-danger small mt-1 d-none">
  Please select a rating
</div>

        <textarea id="feedbackComment"
          class="form-control mb-3"
          placeholder="Write your feedback..."></textarea>

        <button id="submitRating" class="btn btn-light border">
          Submit Review
        </button>

      </div>

      <!-- Customer Feedback -->
      <h5 class="fw-bold mb-3">Customer Feedback</h5>

      <% if (restaurant.reviews && restaurant.reviews.length > 0) { %>
        <% restaurant.reviews.forEach(r => { %>
          <div class="review-card">
            <div class="d-flex justify-content-between align-items-center">
              <strong><%= r.user?.username || "Anonymous" %></strong>
              <div class="review-stars">
                <% for(let i=1;i<=5;i++){ %>
                  <% if(i <= r.value){ %> ★ <% } else { %> ☆ <% } %>
                <% } %>
              </div>
            </div>
            <p class="small text-muted mt-2 mb-0">
              "<%= r.comment %>"
            </p>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-muted">No reviews yet.</p>
      <% } %>

    </div>

    <!-- RIGHT SIDE FORM -->
    <div class="col-lg-7">

      <div class="form-card">

  <div id="formError" class="alert alert-danger d-none mb-3 shadow-sm"></div>
        <div class="form-header">
          <h4 class="fw-bold mb-1">Forwarding Your Issue</h4>
          <p class="small mb-0">Provide your details so we can assist you faster</p>
        </div>

        <div class="form-body">

          <form id="orderForm" enctype="multipart/form-data" novalidate>

            <div class="row">
              <div class="col-md-6 mb-3">
                <input type="text" id="customerFirstName"
                  placeholder="First Name"
                  class="form-control" required>
                    <div class="text-danger small mt-1 d-none" id="customerFirstNameError">
    First name is required
  </div>
              </div>


              <div class="col-md-6 mb-3">
                <input type="text" id="customerLastName"
                  placeholder="Last Name"
                  class="form-control" required>
                    <div class="text-danger small mt-1 d-none" id="customerLastNameError">
    Last name is required
  </div>

              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <input type="number" id="customerPhone"
                  placeholder="Phone"
                  class="form-control" required>
                    <div class="text-danger small mt-1 d-none" id="customerPhoneError">
    Valid phone number is required
  </div>

              </div>

              <div class="col-md-6 mb-3">
                <input type="email" id="customerEmail"
                  placeholder="Email"
                  class="form-control" required>
                    <div class="text-danger small mt-1 d-none" id="customerEmailError">
    Valid email is required
  </div>
              </div>
            </div>

            <div class="mb-3">
              <input type="text" id="customerAddress"
                placeholder="Address"
                class="form-control" required>
                    <div class="text-danger small mt-1 d-none" id="customerAddressError">
    Address is required
             </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <input type="text" id="customerCity"
                  placeholder="City"
                  class="form-control" required>
                    <div class="text-danger small mt-1 d-none" id="customerCityError">
    City is required
    </div>
              </div>

              <div class="col-md-6 mb-3">
                <input type="text" id="customerState"
                  placeholder="State"
                  class="form-control" required>
                    <div class="text-danger small mt-1 d-none" id="customerStateError">
    State is required
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <input type="number" id="customerPincode"
                  placeholder="Pincode"
                  class="form-control" required>
                    <div class="text-danger small mt-1 d-none" id="customerPincodeError">
    Valid pincode is required
    </div>
              </div>

              <div class="col-md-6 mb-3">
                <input type="text" id="customerCountry"
                  placeholder="Country"
                  class="form-control" required>
                    <div class="text-danger small mt-1 d-none" id="customerCountryError">
    Country is required
              </div>
            </div>

            <!-- <div class="mb-4">
              <input type="file" id="video"
                class="form-control"
                accept="video/*" required>
                  <div class="text-danger small mt-1 d-none" id="videoError">
    Video evidence is required
    </div>
            </div> -->

