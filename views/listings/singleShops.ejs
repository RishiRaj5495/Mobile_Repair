<script>

// ============================================
// VIDEO UPLOAD UI
// ============================================

const videoInput = document.getElementById("video");
const uploadVideoButton =
    document.getElementById("uploadVideoButton");

const videoUploadBox =
    document.getElementById("videoUploadBox");

const selectedVideo =
    document.getElementById("selectedVideo");

const videoFileName =
    document.getElementById("videoFileName");

const videoFileSize =
    document.getElementById("videoFileSize");

const removeVideo =
    document.getElementById("removeVideo");

const videoError =
    document.getElementById("videoError");


// ============================================
// CHOOSE VIDEO BUTTON
// ============================================

uploadVideoButton.addEventListener("click", function (e) {

    e.stopPropagation();

    videoInput.click();

});


// ============================================
// CLICK UPLOAD BOX
// ============================================

videoUploadBox.addEventListener("click", function () {

    videoInput.click();

});


// ============================================
// FILE SELECTED
// ============================================

videoInput.addEventListener("change", function () {

    const video = this.files[0];

    if (!video) {
        return;
    }

    handleVideoFile(video);

});


// ============================================
// HANDLE VIDEO
// ============================================

function handleVideoFile(video) {

    // Hide previous error
    videoError.classList.add("d-none");


    // Check video type
    if (!video.type.startsWith("video/")) {

        videoError.classList.remove("d-none");

        videoError.querySelector("span:last-child").textContent =
            "Please select a valid video file.";

        videoInput.value = "";

        return;
    }


    // 50 MB limit
    const maxSize =
        50 * 1024 * 1024;

    if (video.size > maxSize) {

        videoError.classList.remove("d-none");

        videoError.querySelector("span:last-child").textContent =
            "Video must be smaller than 50 MB.";

        videoInput.value = "";

        return;
    }


    // ========================================
    // SHOW SELECTED VIDEO
    // ========================================

    videoFileName.textContent =
        video.name;

    videoFileSize.textContent =
        formatFileSize(video.size);

    selectedVideo.classList.remove(
        "d-none"
    );


    // Optional: hide upload box
    videoUploadBox.classList.add(
        "d-none"
    );


    console.log(
        "Selected video:",
        video.name
    );

}


// ============================================
// FORMAT FILE SIZE
// ============================================

function formatFileSize(bytes) {

    if (bytes < 1024 * 1024) {

        return (
            (bytes / 1024).toFixed(1)
            + " KB"
        );

    }

    return (
        (bytes / (1024 * 1024)).toFixed(2)
        + " MB"
    );
}


// ============================================
// REMOVE VIDEO
// ============================================

removeVideo.addEventListener(
    "click",
    function (e) {

        e.stopPropagation();

        videoInput.value = "";

        selectedVideo.classList.add(
            "d-none"
        );

        videoUploadBox.classList.remove(
            "d-none"
        );

        videoError.classList.add(
            "d-none"
        );

    }
);


// ============================================
// DRAG OVER
// ============================================

videoUploadBox.addEventListener(
    "dragover",
    function (e) {

        e.preventDefault();

        videoUploadBox.classList.add(
            "dragover"
        );

    }
);


// ============================================
// DRAG LEAVE
// ============================================

videoUploadBox.addEventListener(
    "dragleave",
    function () {

        videoUploadBox.classList.remove(
            "dragover"
        );

    }
);


// ============================================
// DROP VIDEO
// ============================================

videoUploadBox.addEventListener(
    "drop",
    function (e) {

        e.preventDefault();

        videoUploadBox.classList.remove(
            "dragover"
        );

        const files =
            e.dataTransfer.files;

        if (!files || !files.length) {
            return;
        }

        const video =
            files[0];

        // Put dropped file into input
        const dataTransfer =
            new DataTransfer();

        dataTransfer.items.add(video);

        videoInput.files =
            dataTransfer.files;

        handleVideoFile(video);

    }
);

</script>